{
  "compilerOptions": {
    "target": "ES2021",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "paths": { "~/*": ["./src/*"] },
    "types": ["bun-types"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  }
}
